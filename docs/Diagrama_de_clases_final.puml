@startuml FutBot_Class_Diagram

top to bottom direction
skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 80
skinparam packageStyle rectangle
hide empty members

package "Gestión de club" as ClubZone #EAF3FF {
    class Usuario {
        -nombre_usuario : String
        -nombre_completo : String
        -email : String
        -contraseña : String

        +cambiar_contraseña(nueva_contraseña : String)
    }

    class Club {
        -id : int
        -nombre : String
        -avatar : String
        -disponible_amistoso : bool

        +cambiar_avatar(nuevo_avatar : String)
    }

    class EquipoDefault {
        -id : int
        -formacion : String

        +cambiar_jugador(entra : Jugador , sale : Jugador)
        +seleccionar_formacion(formacion : String)
    }

    class Jugador {
        -id : int
        -nombre : String
        -poder : int
        -agilidad : int
        -control : int
        -fuerza : int
        -velocidad : int
        -eliminado : bool

        +eliminar()
    }

    class Comportamiento {
        -id : int
        -nombre : String
        -codigo : String
        -eliminado : bool

        +editar(codigo : String)
        +eliminar()
    }
}

package "Gestion de Ligas" as LeagueZone #FFF4D6 {
    class LigaPrivada {
        -clave_acceso : String
    }

    class LigaPublica {
    }

    abstract class Liga {
        -id : int
        -nombre : String
        -min_clubes : int
        -max_clubes : int
        -fecha_hora_inicio : DateTime
        -fecha_hora_fin : DateTime
        -estado : EstadoLiga

        +iniciar()
        +cancelar()
    }

    class InscripcionLiga {
        -id : int
        -fecha_inscripcion : DateTime

        +abandonar()
    }
}

package "Partidos y Fixture" as MatchZone #E8F5E9 {
    class Fixture {
        -id : int

        +generar()
    }

    class Ronda {
        -id : int
        -numero : int
        -fecha_hora_inicio : DateTime
    }

    abstract class Partido {
        -id : int
        -duracion : Duration
        -fecha_hora_inicio : DateTime
        -estado : EstadoPartido
        -marcador1 : int
        -marcador2 : int

        +iniciar()
        +reanudar()
        +finalizar()
        +pausa_hidratacion()
        +entretiempo()
        +solicitar_cambio(sale : Jugador, entra : Jugador)
        +cambiar_comportamiento(jugador : Jugador, comportamiento : Comportamiento)
    }

    class PartidoLiga {
    }

    class PartidoAmistoso {
        +unirse(club : Club)
    }
}

package "Rankings" as RankingZone #F3E8FF {
    class TablaPosicionesLiga {
        -resultados

        +actualizar(partido : PartidoLiga)
    }

    class RankingGlobal {
        -clasificaciones

        +actualizar(partido : PartidoLiga)
    }
}

Usuario "1" *-- "1" Club : administra
Club "1" *-- "6..*" Jugador : jugadores
Club "1" *-- "1..*" Comportamiento : comportamientos
Jugador "*" --> "0..1" Comportamiento : comportamiento
Club "1" *-- "1" EquipoDefault : equipo_default
EquipoDefault "1" --> "6" Jugador : jugadores
Liga "*" --> "1" Club : creador
Liga "1" *-- "0..*" InscripcionLiga : inscripciones
Club "1" -- "0..*" InscripcionLiga : participa
InscripcionLiga "1" --> "6" Jugador : jugadores_registrados
Liga "1" *-- "1" TablaPosicionesLiga : posiciones
TablaPosicionesLiga --> Club : clasifica
Liga "1" *-- "0..1" Fixture : fixture
Fixture "1" *-- "1..*" Ronda : rondas
Ronda "1" *-- "1..*" PartidoLiga : partidos
PartidoLiga "*" --> "2" InscripcionLiga : participantes
PartidoAmistoso "*" --> "2" Club : participantes
LigaPrivada --|> Liga
LigaPublica --|> Liga
PartidoLiga --|> Partido
PartidoAmistoso --|> Partido

' Visual layout hints only; they do not represent domain relationships.
Club -[hidden]right- Liga
Liga -[hidden]right- Fixture
Fixture -[hidden]right- TablaPosicionesLiga

Usuario -[hidden]down- Club
Club -[hidden]down- EquipoDefault
EquipoDefault -[hidden]right- Jugador
Jugador -[hidden]down- Comportamiento

LigaPrivada -[hidden]down- LigaPublica
Liga -[hidden]down- InscripcionLiga

Fixture -[hidden]down- Ronda
Ronda -[hidden]down- PartidoLiga
PartidoLiga -[hidden]down- PartidoAmistoso

TablaPosicionesLiga -[hidden]down- RankingGlobal

@enduml
